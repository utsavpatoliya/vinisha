# ============================================
# Order Management System - Environment Config
# Copy this file to ".env" and fill in your values
# ============================================

# Server
PORT=3000
NODE_ENV=development

# MongoDB Atlas connection string
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/order_management?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://utsavpatoliya0407_db_user:3vzcIz1EBddmdqBV@cluster0.udjo0cs.mongodb.net/?appName=Cluster0

# Session secret - use a long random string in production
SESSION_SECRET=change_this_to_a_long_random_string

# Shop owner login credentials
# Default username/password is admin/admin (see OWNER_PASSWORD_HASH below,
# which is the bcrypt hash for the plain text password "admin").
# You can generate your own hash by running: npm run create-owner
OWNER_USERNAME=vinisha
OWNER_PASSWORD_HASH=$2a$10$6lYkGg4F1Zcc.oZ/SrI0zOhfz2lCxbi0/poL5OP9VBg4nazXDJSfu

# Shop details (shown on invoices)
