<!DOCTYPE html>
<html lang="gu">
<head>
<meta charset="UTF-8" />
<title>Invoice <%= order.invoiceNumber %></title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Noto+Sans+Gujarati:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
  rel="stylesheet"
/>
<style>
  * { box-sizing: border-box; }
  body {
    font-family: 'Inter', 'Noto Sans Gujarati', Arial, sans-serif;
    color: #1a1a1a;
    margin: 0;
    padding: 32px;
    font-size: 14px;
  }
  .gujarati { font-family: 'Noto Sans Gujarati', 'Inter', Arial, sans-serif; }

  .invoice-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    border-bottom: 3px solid #2b59ff;
    padding-bottom: 16px;
    margin-bottom: 24px;
  }
  .shop-name {
    font-size: 24px;
    font-weight: 700;
    color: #2b59ff;
    margin: 0 0 4px 0;
  }
  .shop-meta {
    font-size: 12px;
    color: #555;
    line-height: 1.5;
  }
  .invoice-badge {
    text-align: right;
  }
  .invoice-badge h2 {
    margin: 0;
    font-size: 20px;
    letter-spacing: 1px;
    color: #1a1a1a;
  }
  .invoice-badge .invoice-number {
    font-size: 16px;
    font-weight: 700;
    color: #2b59ff;
    margin-top: 4px;
  }

  .meta-grid {
    display: flex;
    justify-content: space-between;
    margin-bottom: 24px;
    gap: 16px;
  }
  .meta-block {
    flex: 1;
    background: #f7f8fc;
    border-radius: 8px;
    padding: 12px 16px;
  }
  .meta-block .label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #888;
    margin-bottom: 4px;
  }
  .meta-block .value {
    font-size: 15px;
    font-weight: 600;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 24px;
  }
  thead th {
    background: #2b59ff;
    color: #fff;
    text-align: left;
    padding: 10px 12px;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  thead th:last-child, tbody td:last-child {
    text-align: right;
  }
  tbody td {
    padding: 10px 12px;
    border-bottom: 1px solid #e8e8e8;
    font-size: 14px;
  }
  tbody tr:nth-child(even) {
    background: #fafafa;
  }
  .product-gujarati {
    font-size: 16px;
    font-weight: 500;
  }

  .notes-box {
    background: #fff8e6;
    border: 1px solid #ffe4a3;
    border-radius: 8px;
    padding: 12px 16px;
    font-size: 13px;
    margin-bottom: 24px;
  }

  .footer {
    text-align: center;
    color: #999;
    font-size: 11px;
    border-top: 1px solid #e8e8e8;
    padding-top: 16px;
    margin-top: 32px;
  }
  .text-right { text-align: right; }

</style>
</head>
<body>
  <div class="invoice-header">
    <div style="display: flex; align-items: center; gap: 12px;">
      <% if (typeof logoDataUri !== 'undefined' && logoDataUri) { %>
        <img src="<%= logoDataUri %>" alt="Logo" style="height: 55px; width: auto; object-fit: contain;" />
      <% } %>
      <div>
        <p class="shop-name"><%= shop.name %></p>
        <div class="shop-meta">
          <% if (shop.address) { %><div><%= shop.address %></div><% } %>
          <% if (shop.phone) { %><div><%= shop.phone %></div><% } %>
        </div>
      </div>
    </div>
    <div class="invoice-badge">
      <h2>INVOICE</h2>
      <div class="invoice-number"><%= order.invoiceNumber %></div>
    </div>
  </div>

  <div class="meta-grid">
    <div class="meta-block">
      <div class="label">Customer</div>
      <div class="value"><%= order.customerName %></div>
    </div>
    <div class="meta-block">
      <div class="label">Order Date</div>
      <div class="value"><%= new Date(order.orderDate).toLocaleDateString() %></div>
    </div>
  </div>

  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>Product</th>
        <th class="text-right">Price</th>
        <th class="text-right">Quantity</th>
        <th class="text-right">Total</th>
      </tr>
    </thead>
    <tbody>
      <% order.products.forEach((p, i) => { %>
        <tr>
          <td><%= i + 1 %></td>
          <td class="gujarati product-gujarati"><%= p.nameGujarati %></td>
          <td class="text-right">₹<%= (p.price || 0).toFixed(2) %></td>
          <td class="text-right"><%= p.quantity %></td>
          <td class="text-right">₹<%= ((p.price || 0) * p.quantity).toFixed(2) %></td>
        </tr>
      <% }) %>
    </tbody>
    <tfoot>
      <tr style="font-weight: bold; border-top: 2px solid #2b59ff;">
        <td colspan="4" class="text-right" style="padding: 12px 10px;">Grand Total:</td>
        <td class="text-right" style="padding: 12px 10px; color: #2b59ff;">₹<%= (order.totalAmount || 0).toFixed(2) %></td>
      </tr>
    </tfoot>
  </table>

  <% if (order.notes) { %>
    <div class="notes-box">
      <strong>Notes:</strong> <%= order.notes %>
    </div>
  <% } %>

  <div class="footer">
    Generated by Vinisha Refrigeration &middot; <%= generatedAt.toLocaleString() %>
  </div>
</body>
</html>
