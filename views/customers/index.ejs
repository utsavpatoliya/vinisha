<%- include('../partials/header') %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-1 mb-3">
  <form class="d-flex" role="search" method="GET" action="/customers">
    <div class="input-group">
      <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
      <input
        type="text"
        class="form-control"
        name="search"
        value="<%= search %>"
        placeholder="Search customers..."
      />
      <% if (search) { %>
        <a href="/customers" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
      <% } %>
    </div>
  </form>
  <a href="/customers/add" class="btn btn-primary">
    <i class="bi bi-plus-lg me-1"></i> Add Customer
  </a>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <% if (customers.length === 0) { %>
      <div class="text-center text-muted py-5">
        <i class="bi bi-people fs-1 d-block mb-2"></i>
        No customers found.
      </div>
    <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th>Name</th>
            <th>Added On</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% customers.forEach(c => { %>
            <tr>
              <td>
                <a href="/customers/<%= c._id %>" class="text-decoration-none fw-semibold">
                  <i class="bi bi-person-circle text-muted me-2"></i><%= c.name %>
                </a>
              </td>
              <td class="text-muted small"><%= new Date(c.createdAt).toLocaleDateString() %></td>
              <td class="text-end">
                <a href="/customers/<%= c._id %>" class="btn btn-sm btn-outline-secondary" title="View">
                  <i class="bi bi-eye"></i>
                </a>
                <a href="/customers/edit/<%= c._id %>" class="btn btn-sm btn-outline-primary" title="Edit">
                  <i class="bi bi-pencil"></i>
                </a>
                <button
                  type="button"
                  class="btn btn-sm btn-outline-danger btn-delete"
                  data-action="/customers/delete/<%= c._id %>"
                  data-message="Delete customer &quot;<%= c.name %>&quot;? This is only possible if they have no orders."
                  title="Delete"
                >
                  <i class="bi bi-trash"></i>
                </button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>

<% if (totalPages > 1) { %>
  <nav class="mt-3">
    <div class="d-flex justify-content-center">
      <div class="pagination-scroll-container">
        <ul class="pagination mb-0" style="display: flex; flex-wrap: nowrap; width: max-content;">
          <% for (let p = 1; p <= totalPages; p++) { %>
            <li class="page-item <%= p === page ? 'active' : '' %>">
              <a class="page-link" href="/customers?page=<%= p %>&search=<%= encodeURIComponent(search) %>"><%= p %></a>
            </li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>
<% } %>

<%- include('../partials/footer') %>
