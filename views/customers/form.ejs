<%- include('../partials/header') %>

<div class="row justify-content-center mt-1">
  <div class="col-12 col-md-6 col-lg-5">
    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">
        <% if (error) { %>
          <div class="alert alert-danger"><%= error %></div>
        <% } %>
        <form action="<%= customer && customer._id ? '/customers/edit/' + customer._id : '/customers/add' %>" method="POST">
          <div class="mb-3">
            <label for="name" class="form-label">Customer Name</label>
            <input
              type="text"
              class="form-control"
              id="name"
              name="name"
              value="<%= customer ? customer.name : '' %>"
              placeholder="e.g. Rajesh Patel - Surat"
              required
              autofocus
            />
          </div>
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill">
              <i class="bi bi-check-lg me-1"></i> <%= customer && customer._id ? 'Save Changes' : 'Add Customer' %>
            </button>
            <a href="/customers" class="btn btn-light">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
