<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mt-1 mb-3">
  <div>
    <h2 class="h5 mb-1"><i class="bi bi-person-circle me-2 text-primary"></i><%= customer.name %></h2>
    <p class="text-muted mb-0 small">Customer since <%= new Date(customer.createdAt).toLocaleDateString() %></p>
  </div>
  <div class="d-flex gap-2">
    <a href="/customers/edit/<%= customer._id %>" class="btn btn-outline-primary">
      <i class="bi bi-pencil me-1"></i> Edit
    </a>
    <a href="/orders/add" class="btn btn-primary">
      <i class="bi bi-plus-lg me-1"></i> New Order
    </a>
  </div>
</div>

<div class="row g-3 mb-3">
  <div class="col-6 col-md-3">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <div class="stat-value"><%= totalOrders %></div>
        <div class="stat-label">Total Orders</div>
      </div>
    </div>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-header bg-white border-0 pt-3">
    <h3 class="h6 mb-0 fw-bold">Order History</h3>
  </div>
  <div class="card-body p-0">
    <% if (orders.length === 0) { %>
      <div class="text-center text-muted py-5">
        <i class="bi bi-receipt fs-1 d-block mb-2"></i>
        No orders placed yet.
      </div>
    <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th>Invoice #</th>
            <th>Date</th>
            <th>Products</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% orders.forEach(order => { %>
            <tr>
              <td class="fw-semibold"><%= order.invoiceNumber %></td>
              <td class="text-muted small"><%= new Date(order.orderDate).toLocaleDateString() %></td>
              <td class="small"><%= order.products.length %> item(s)</td>
              <td class="text-end">
                <a href="/orders/<%= order._id %>" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a>
                <a href="/orders/edit/<%= order._id %>" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                <a href="/orders/pdf/<%= order._id %>" class="btn btn-sm btn-outline-dark"><i class="bi bi-file-earmark-pdf"></i></a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
