<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mt-1 mb-3">
  <div>
    <h2 class="h5 mb-1">Invoice <%= order.invoiceNumber %></h2>
    <p class="text-muted mb-0 small">
      Placed on <%= new Date(order.orderDate).toLocaleDateString() %>
      &middot; Created <%= new Date(order.createdAt).toLocaleString() %>
      <% if (order.updatedAt && order.updatedAt.getTime() !== order.createdAt.getTime()) { %>
        &middot; Last updated <%= new Date(order.updatedAt).toLocaleString() %>
      <% } %>
    </p>
  </div>
  <div class="d-flex gap-2">
    <a href="/orders/pdf/<%= order._id %>" class="btn btn-outline-dark"><i class="bi bi-file-earmark-pdf me-1"></i> Download PDF</a>
    <a href="/orders/edit/<%= order._id %>" class="btn btn-primary"><i class="bi bi-pencil me-1"></i> Edit Order</a>
  </div>
</div>

<div class="row g-3">
  <div class="col-12 col-lg-8">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-0 pt-3">
        <h3 class="h6 mb-0 fw-bold">Products</h3>
      </div>
      <div class="card-body pt-0">
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead>
              <tr>
                <th>English</th>
                <th>Gujarati</th>
                <th class="text-end">Price</th>
                <th class="text-end">Quantity</th>
                <th class="text-end">Total</th>
              </tr>
            </thead>
            <tbody>
              <% order.products.forEach(p => { %>
                <tr>
                  <td><%= p.nameHinglish %></td>
                  <td class="gujarati-text"><%= p.nameGujarati %></td>
                  <td class="text-end">₹<%= (p.price || 0).toFixed(2) %></td>
                  <td class="text-end"><%= p.quantity %></td>
                  <td class="text-end">₹<%= ((p.price || 0) * p.quantity).toFixed(2) %></td>
                </tr>
              <% }) %>
            </tbody>
            <tfoot>
              <tr>
                <td colspan="4" class="text-end fw-bold">Grand Total:</td>
                <td class="text-end fw-bold">₹<%= (order.totalAmount || 0).toFixed(2) %></td>
              </tr>
            </tfoot>
          </table>
        </div>
        <% if (order.notes) { %>
          <div class="alert alert-light border mt-3 mb-0">
            <strong>Notes:</strong> <%= order.notes %>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <div class="col-12 col-lg-4">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <h3 class="h6 fw-bold mb-3">Order Info</h3>
        <dl class="row mb-0 small">
          <dt class="col-5 text-muted">Customer</dt>
          <dd class="col-7">
            <a href="/customers/<%= order.customer %>"><%= order.customerName %></a>
          </dd>
          <dt class="col-5 text-muted">Invoice #</dt>
          <dd class="col-7"><%= order.invoiceNumber %></dd>
          <dt class="col-5 text-muted">Total Items</dt>
          <dd class="col-7"><%= order.products.length %></dd>
          <dt class="col-5 text-muted fw-bold">Total Amount</dt>
          <dd class="col-7 fw-bold">₹<%= (order.totalAmount || 0).toFixed(2) %></dd>
        </dl>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
